{
  "name": "dsh-batch-review",
  "version": "1.0.0",
  "description": "Native per-item review cards for DeepSeek Harness: one batch_review tool call, structured verdicts back. Ships a one-screen panel in the Web UI served by the host's own /api/batch-review routes — no separate app to open, no extra port.",
  "type": "module",
  "sideEffects": ["lib/client.js"],
  "license": "MIT",
  "author": "palx666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palx666/dsh-batch-review.git"
  },
  "homepage": "https://github.com/palx666/dsh-batch-review#readme",
  "bugs": {
    "url": "https://github.com/palx666/dsh-batch-review/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <=0.2.1-rc.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "batch-review",
    "human-in-the-loop",
    "approval",
    "review"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "skills/batch-review-table/SKILL.md",
    "skills/batch-review-table/SKILL.en.md",
    "skills/batch-review-table/references",
    "skills/batch-review-table/assets/review.html",
    "skills/batch-review-table/scripts/build_review.py",
    "skills/batch-review-table/scripts/collect_server.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
